<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Share Capital Reorganisation Calculator</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            max-width: 900px;
            margin: 0 auto;
            padding: 20px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }

        .container {
            background: rgba(255, 255, 255, 0.95);
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            backdrop-filter: blur(10px);
        }

        h1 {
            color: #2c3e50;
            text-align: center;
            margin-bottom: 10px;
            font-size: 2.2em;
            font-weight: 600;
        }

        .company-name {
            text-align: center;
            color: #7f8c8d;
            font-size: 1.1em;
            margin-bottom: 30px;
            font-style: italic;
        }

        .section {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
            border-left: 4px solid #3498db;
        }

        .section h2 {
            color: #2c3e50;
            margin-top: 0;
            margin-bottom: 15px;
            font-size: 1.3em;
        }

        .input-group {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 15px;
        }

        .input-field {
            flex: 1;
            min-width: 200px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            font-weight: 500;
            color: #2c3e50;
        }

        input[type="number"] {
            width: 100%;
            padding: 12px;
            border: 2px solid #e1e8ed;
            border-radius: 8px;
            font-size: 16px;
            transition: border-color 0.3s ease;
            box-sizing: border-box;
        }

        input[type="number"]:focus {
            outline: none;
            border-color: #3498db;
            box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
        }

        .results {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px;
            border-radius: 10px;
            margin-top: 20px;
        }

        .results h2 {
            margin-top: 0;
            color: white;
        }

        .result-item {
            background: rgba(255, 255, 255, 0.1);
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 10px;
            backdrop-filter: blur(5px);
        }

        .result-item strong {
            font-size: 1.1em;
        }

        .highlight {
            background: rgba(255, 255, 255, 0.2);
            padding: 20px;
            border-radius: 10px;
            text-align: center;
            font-size: 1.2em;
            font-weight: bold;
            margin-top: 15px;
        }

        .warning {
            background: #fff3cd;
            border: 1px solid #ffeaa7;
            color: #856404;
            padding: 15px;
            border-radius: 8px;
            margin-top: 15px;
        }

        .info-box {
            background: #e8f4fd;
            border: 1px solid #bee5eb;
            color: #0c5460;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .mode-toggle {
            display: flex;
            gap: 20px;
            align-items: center;
            margin-bottom: 10px;
        }

        @media (max-width: 600px) {
            .input-group {
                flex-direction: column;
            }
            
            .input-field {
                min-width: auto;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Share Capital Reorganisation Calculator</h1>
        <div class="company-name">Hydrogen Future Industries plc</div>

        <div class="info-box">
            <strong>Purpose:</strong> This calculator helps determine the new par value per share and other figures when reorganising share capital, either by targeting a new number of shares or a desired new share price, while preserving the total nominal capital.
        </div>

        <div class="section">
            <h2>Current Share Capital Position</h2>
            <div class="input-group">
                <div class="input-field">
                    <label for="currentShares">Current Shares in Issue:</label>
                    <input type="number" id="currentShares" value="64656250" min="1" onchange="calculateReorganisation()" oninput="calculateReorganisation()">
                </div>
                <div class="input-field">
                    <label for="currentParValue">Current Par Value (pence per share):</label>
                    <input type="number" id="currentParValue" value="1" min="0.01" step="0.01" onchange="calculateReorganisation()" oninput="calculateReorganisation()">
                </div>
                <div class="input-field">
                    <label for="currentSharePrice">Current Share Price (pence per share):</label>
                    <input type="number" id="currentSharePrice" value="1.5" min="0.01" step="0.01" onchange="calculateReorganisation()" oninput="calculateReorganisation()">
                </div>
            </div>
        </div>

        <div class="section">
            <h2>Proposed Reorganisation</h2>

            <div class="mode-toggle">
                <label><input type="radio" name="calculationMode" value="shares" checked onchange="toggleCalculationMode()"> Calculate by desired number of shares</label>
                <label><input type="radio" name="calculationMode" value="price" onchange="toggleCalculationMode()"> Calculate by desired new share price</label>
            </div>

            <!-- Inputs for "by shares" mode -->
            <div class="input-group" id="sharesModeInputs">
                <div class="input-field">
                    <label for="newShares">Desired New Shares in Issue:</label>
                    <input type="number" id="newShares" value="10000000" min="1" placeholder="e.g., 10,000,000" onchange="calculateReorganisation()" oninput="calculateReorganisation()">
                </div>
            </div>

            <!-- Inputs for "by price" mode -->
            <div class="input-group" id="priceModeInputs" style="display:none;">
                <div class="input-field">
                    <label for="desiredSharePrice">Desired New Share Price (pence per share):</label>
                    <input type="number" id="desiredSharePrice" value="9.7" min="0.01" step="0.01" placeholder="e.g., 10.00" onchange="calculateReorganisation()" oninput="calculateReorganisation()">
                </div>
            </div>

            <div class="warning">
                <strong>Note:</strong> Choose a mode above. In “by shares” mode, enter your desired number of shares; in “by price” mode, enter the desired new share price. The calculator preserves total nominal capital and updates all figures accordingly.
            </div>
        </div>

        <div class="results" id="results">
            <h2>Reorganisation Results</h2>
            
            <div class="result-item">
                <strong>Current Market Capitalisation:</strong> £<span id="currentMarketCap">969,843.75</span>
            </div>
            
            <div class="result-item">
                <strong>Current Total Nominal Capital:</strong> £<span id="currentTotal">646,562.50</span>
            </div>
            
            <div class="result-item">
                <strong>Required New Par Value:</strong> <span id="newParValue">6.47</span> pence per share
            </div>

            <div class="result-item">
                <strong>New Share Price:</strong> <span id="newSharePrice">9.70</span> pence per share
            </div>

            <div class="result-item">
                <strong>Calculated New Shares:</strong> <span id="calculatedShares">10,000,000</span>
            </div>
            
            <div class="result-item">
                <strong>New Market Capitalisation:</strong> £<span id="newMarketCap">969,843.75</span> (unchanged)
            </div>
            
            <div class="result-item">
                <strong>New Total Nominal Capital:</strong> £<span id="newTotal">646,562.50</span>
            </div>
            
            <div class="result-item">
                <strong>Reduction in Share Count:</strong> <span id="shareReduction">54,656,250</span> shares (<span id="reductionPercent">84.5</span>%)
            </div>

            <div class="highlight">
                <div>Reorganisation Ratio:</div>
                <div>1 new share for every <span id="consolidationRatio">6.47</span> existing shares</div>
            </div>
        </div>
    </div>

    <script>
        function formatNumber(num) {
            return num.toLocaleString('en-GB', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        function formatWholeNumber(num) {
            return num.toLocaleString('en-GB');
        }

        function toggleCalculationMode() {
            const sharesModeInputs = document.getElementById('sharesModeInputs');
            const priceModeInputs = document.getElementById('priceModeInputs');
            const selectedMode = document.querySelector('input[name="calculationMode"]:checked').value;
            
            if (selectedMode === 'shares') {
                sharesModeInputs.style.display = 'flex';
                priceModeInputs.style.display = 'none';
            } else {
                sharesModeInputs.style.display = 'none';
                priceModeInputs.style.display = 'flex';
            }
            
            calculateReorganisation();
        }

        function calculateReorganisation() {
            try {
                const currentShares = parseFloat(document.getElementById('currentShares').value) || 0;
                const currentParValue = parseFloat(document.getElementById('currentParValue').value) || 0;
                const currentSharePrice = parseFloat(document.getElementById('currentSharePrice').value) || 0;
                const selectedMode = document.querySelector('input[name="calculationMode"]:checked')?.value || 'shares';

                if (currentShares <= 0 || currentParValue <= 0 || currentSharePrice <= 0) {
                    return;
                }

                // Current market cap & total nominal (in pounds)
                const currentMarketCap = (currentShares * currentSharePrice) / 100;
                const currentTotal = (currentShares * currentParValue) / 100;
                
                let newShares, newSharePrice, newParValue;
                
                if (selectedMode === 'shares') {
                    // Calculate by desired number of shares
                    newShares = parseFloat(document.getElementById('newShares').value) || 0;
                    if (newShares <= 0) return;
                    
                    // Required new par value (in pence)
                    newParValue = (currentTotal * 100) / newShares;
                    // New share price (in pence)
                    newSharePrice = (currentMarketCap * 100) / newShares;
                } else {
                    // Calculate by desired share price
                    const desiredSharePrice = parseFloat(document.getElementById('desiredSharePrice').value) || 0;
                    if (desiredSharePrice <= 0) return;
                    
                    newSharePrice = desiredSharePrice;
                    // Number of shares needed for desired price
                    newShares = (currentMarketCap * 100) / newSharePrice;
                    // Required new par value (in pence)
                    newParValue = (currentTotal * 100) / newShares;
                }
                
                // New totals (should equal current)
                const newTotal = (newShares * newParValue) / 100;
                const newMarketCap = (newShares * newSharePrice) / 100;
                
                // Share reduction & consolidation ratio
                const shareReduction = currentShares - newShares;
                const reductionPercent = (shareReduction / currentShares) * 100;
                const consolidationRatio = currentShares / newShares;

                // Update results
                const elements = {
                    'currentMarketCap': formatNumber(currentMarketCap),
                    'currentTotal': formatNumber(currentTotal),
                    'calculatedShares': formatWholeNumber(newShares),
                    'newParValue': formatNumber(newParValue),
                    'newSharePrice': formatNumber(newSharePrice),
                    'newMarketCap': formatNumber(newMarketCap),
                    'newTotal': formatNumber(newTotal),
                    'shareReduction': formatWholeNumber(Math.abs(shareReduction)),
                    'reductionPercent': formatNumber(Math.abs(reductionPercent)),
                    'consolidationRatio': formatNumber(consolidationRatio)
                };

                for (const [id, value] of Object.entries(elements)) {
                    const element = document.getElementById(id);
                    if (element) {
                        element.textContent = value;
                    }
                }
            } catch (error) {
                console.log('Calculation error:', error);
            }
        }

        // Initialise view and calculation
        toggleCalculationMode();
        setTimeout(calculateReorganisation, 100);
    </script>
</body>
</html>
